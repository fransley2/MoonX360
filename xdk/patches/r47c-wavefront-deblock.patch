+
+/* Each job owns one scratch context. Rows are claimed in ascending order;
+ * even a single scheduled worker can always finish the oldest row. An edge
+ * can touch its left and upper neighbours, so wait for the upper row to
+ * finish one MB beyond each chunk before writing any pixels. */
+enum { ROW_LIMIT = 128, FILTER_CHUNK = 8 };
+typedef struct RowFilterBatch {
+    H264Context **contexts;
+    int first, end;
+    volatile LONG next_row;
+    volatile LONG progress[ROW_LIMIT];
+} RowFilterBatch;
+
+static int filter_rows_job(AVCodecContext *avctx, void *arg, int job, int thread)
+{
+    RowFilterBatch *batch = arg;
+    H264Context *h = batch->contexts[job];
+    const int saved_x = h->mb_x, saved_y = h->mb_y;
+    const int saved_slice = h->slice_num, saved_lists = h->list_count;
+    int row, x;
+    while ((row = InterlockedIncrement(&batch->next_row) - 1) < batch->end) {
+        h->mb_y = row;
+        for (x = 0; x < h->mb_width; x += FILTER_CHUNK) {
+            int end = FFMIN(x + FILTER_CHUNK, h->mb_width);
+            int need = FFMIN(end + 1, h->mb_width);
+            if (row > batch->first) {
+                while (InterlockedCompareExchange(&batch->progress[row - 1], 0, 0) < need)
+                    YieldProcessor();
+            }
+            loop_filter_range(h, x, end, 0);
+            InterlockedExchange(&batch->progress[row], end);
+        }
+    }
+    h->mb_x = saved_x;
+    h->mb_y = saved_y;
+    h->slice_num = saved_slice;
+    h->list_count = saved_lists;
+    return 0;
+}
+
+static int filter_complete_rows(H264Context *master, int count)
+{
+    RowFilterBatch batch;
+    int i, next = master->resync_mb_y;
+    if (master->mb_height > ROW_LIMIT || master->sps.chroma_format_idc != 1 ||
+        master->sps.bit_depth_luma != 8)
+        return 0;
+    for (i = 0; i < count; i++) {
+        H264Context *h = master->thread_context[i];
+        if (h->resync_mb_x || h->resync_mb_y != next || h->mb_x ||
+            h->mb_y <= next || h->mb_y > master->mb_height ||
+            h->deblocking_filter != 1 || h->qp_thresh != master->qp_thresh ||
+            h->slice_alpha_c0_offset != master->slice_alpha_c0_offset ||
+            h->slice_beta_offset != master->slice_beta_offset ||
+            h->slice_type != master->slice_type || memcmp(&h->pps, &master->pps, sizeof(h->pps)))
+            return 0;
+        next = h->mb_y;
+    }
+    batch.contexts = master->thread_context;
+    batch.next_row = batch.first = master->resync_mb_y;
+    batch.end = next;
+    memset((void *)batch.progress, 0, sizeof(batch.progress));
+    master->avctx->execute2(master->avctx, filter_rows_job, &batch, NULL, count);
+    return 1;
 }
 
