+/* Eight slice contexts share four persistent workers. Reserve the per-context
+ * scratch rows with the same capacity used to allocate the contexts. */
+static int slice_capacity(const H264Context *h)
+{
+    if (h->avctx->active_thread_type == FF_THREAD_SLICE && h->avctx->thread_count == 4)
+        return 8;
+    return FFMAX(1, h->avctx->thread_count);
+}
