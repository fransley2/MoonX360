# Publish the application and its reproducible dashboard build inputs only.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/THIRD_PARTY_NOTICES.md
!/CONTRIBUTING.md
!/README.md
!/RELEASE_NOTES_v0.2.2.md
!/Makefile
!/src/
!/compat/
!/hwpthread/
!/scripts/
!/tools/
!/third_party/
!/assets/
!/xdk/
!/docs/

# Preserve the maintained guides; local reports and dated evidence stay local.
/docs/*
!/docs/BUILD.md
!/docs/DEPENDENCIES.md
!/docs/LIMITATIONS.md
!/docs/PUBLICATION.md
!/docs/SETUP.md

# Downloaded dependency trees, SDKs, and generated build output.
/xdk/deps/
/xdk/build/
/xdk/SDK/
/xdk/XDK/
**/dev kits/
xdk/deps/XBMC-360/libraries/ffmpeg/vcproj/external/pthreads/need_errno.h
xdk/deps/XBMC-360/libraries/ffmpeg/vcproj/external/zlib/contrib/
xdk/deps/XBMC-360/libraries/ffmpeg/vcproj/external/zlib/zlib.3.pdf
xdk/*.md
!xdk/README.md

# Local exports, test runs, generated artifacts, and private runtime data.
/dist/
/publication/
/evidencias/
/host-tests/
/host-tests-*/
/test-support/
